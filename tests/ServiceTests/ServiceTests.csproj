<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pruebas automáticas de la capa de modelos y servicios (no incluye las pantallas de WinForms).
       Correr desde la raiz del proyecto con: dotnet run (parametro project) tests\ServiceTests, configuracion Release -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Velin/Models/*.cs" />
    <Compile Include="../../Velin/Services/*.cs" Exclude="../../Velin/Services/SoundManager.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
