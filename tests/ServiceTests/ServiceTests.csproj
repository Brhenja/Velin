<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pruebas automáticas del núcleo de Velin (Velin.Core: modelos y servicios; no incluye las pantallas de WinForms).
       Correr desde la raiz del proyecto con: dotnet run (parametro project) tests\ServiceTests, configuracion Release -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Velin.Core/Velin.Core.csproj" />
  </ItemGroup>
</Project>
